---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CutCard from '../components/CutCard.astro';
import Guilloche from '../components/Guilloche.astro';

// Held back from the coming-soon glimpse only - the Cuts themselves, their
// signed URLs, and the machine layer are untouched (the Spine is append-only).
const HIDDEN_FROM_HOME = new Set(['cut-0200', 'cut-0203', 'cut-0211', 'cut-0212']);

const cuts = (await getCollection('cuts', (c) => !c.data.draft && !HIDDEN_FROM_HOME.has(c.data.id)))
  .sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.id.localeCompare(b.data.id),
  );

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'agenticpayments.dev',
  url: 'https://agenticpayments.dev/',
  description:
    'Cuts on agentic payments: atomic, schema’d, CC-BY-licensed primitives of operator thinking, plus a machine layer built for agents.',
};
---

<Base
  title="Operator notes on agentic payments"
  description="Operator notes on agentic payments and commerce - short, dated, licensed Cuts written for people and structured for agents. Full site coming soon; a glimpse below."
  path="/"
  jsonld={jsonld}
>
  <div class="wrap">
    <section class="masthead">
      <h1>Operator notes on agentic payments and commerce,<br />served by the cut.</h1>

      <div class="intro">
        <p class="eyebrow eyebrow--accent">Coming soon</p>
        <p class="intro-who measure">
          I'm <strong><a href="https://linkedin.com/in/kmaquasar">Ankit</a></strong> -
          2x Fintech Founder and Fellow in Residence at
          <a href="https://indiastack.org">India Stack</a>
          (<a href="https://en.wikipedia.org/wiki/Unified_Payments_Interface">UPI</a>,
          <a href="https://ocen.dev">OCEN</a>). I'm turning my
          <a href="https://embed.substack.com">blog</a> into this: operator notes on
          agentic payments and commerce, published as <strong>Cuts</strong> - one idea in
          ~180 words, visual primitives and more. There's a lot more on the way and a
          glimpse of it is below.
        </p>
      </div>

      <div class="band"><Guilloche /></div>
    </section>

    <section class="case-section" aria-label="The cuts, newest first">
      <p class="case-label">The cuts - newest first</p>
      <div class="counter-grid">
        {cuts.map((cut) => (
          <CutCard cut={cut} />
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .masthead { padding: 2.6rem 0 2.4rem; }
  .band { margin-top: 2.2rem; }
  h1 { font-size: var(--fs-xxl); font-weight: 700; max-width: 46rem; }

  .intro { margin-top: 1.1rem; display: grid; gap: 0.5rem; }
  .intro-who { font-size: var(--fs-lg); color: var(--ink); line-height: 1.55; }

  .case-section { margin-bottom: 2.6rem; }
  .case-label {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    color: var(--ink);
    background: var(--tint2);
    border: 1px solid var(--rule2);
    display: inline-block;
    padding: 0.25rem 0.7rem;
    margin: 0 0 1rem;
  }
  .counter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0 2rem;
  }
</style>
